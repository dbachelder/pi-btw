{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"types": ["node"],
		"allowImportingTsExtensions": true
	},
	"include": ["extensions/**/*.ts", "lib/**/*.ts"]
}